# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
PG_URI=postgresql://your_user:your_password@your_host:port/your_database?sslmode=require

# Example for Neon database:
# PG_URI=postgresql://username:password@ep-xxxxx-xxxxx.region.aws.neon.tech/database?sslmode=require

# Flask Configuration (optional)
FLASK_ENV=development
FLASK_DEBUG=True
