{
  "name": "mcp-pokemon-server",
  "version": "1.0.0",
  "description": "MCP Server for Pokemon data - Chapter 23",
  "main": "app.ts",
  "type": "module",
  "imports": {
    "#tools": {
      "development": "./src/tools/index.ts",
      "default": "./dist/tools/index.js"
    },
    "#resources": {
      "development": "./src/resources/index.ts",
      "default": "./dist/resources/index.js"
    },
    "#prompts": {
      "development": "./src/prompts/index.ts",
      "default": "./dist/prompts/index.js"
    },
    "#utils": {
      "development": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "dev": "node --watch --conditions development --experimental-transform-types --disable-warning=ExperimentalWarning src/app.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pokedex-promise-v2": "^4.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  }
}
